                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/appointments/{{appointmentId}}/preparation",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Solicitação fictícia QA {{runId}}\",\n  \"symptoms\": \"Contexto fictício para teste automatizado, sem dados clínicos reais.\",\n  \"questions\": \"Pergunta fictícia de QA\",\n  \"meds\": \"\"\n}",
              "options": {
