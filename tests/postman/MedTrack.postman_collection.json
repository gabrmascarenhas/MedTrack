    {
      "name": "07 — Solicitar consulta com preparação",
      "item": [
        {
          "name": "Criar solicitação",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"preparation\": {\n    \"reason\": \"Solicitação fictícia QA {{runId}}\",\n    \"symptoms\": \"Contexto fictício para teste automatizado, sem dados clínicos reais.\",\n    \"questions\": \"Pergunta fictícia de QA\",\n    \"meds\": \"\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const a=pm.response.json().appointment; pm.collectionVariables.set('appointmentId',a.id);",
                  "pm.test('Preparação e participantes corretos', () => { pm.expect(a.status).to.eql('Solicitada'); pm.expect(a.doctorId).to.eql(pm.collectionVariables.get('doctorId')); pm.expect(a.patientId).to.eql(pm.collectionVariables.get('patientId')); pm.expect(a.prep.symptoms).to.eql('Contexto fictício para teste automatizado, sem dados clínicos reais.'); });"
                ]
              }
            }
          ]
        }
      ]
    },
