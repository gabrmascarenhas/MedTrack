{
  "info": {
    "name": "MedTrack — 15 cenários de API",
    "description": "Executar a coleção completa em ordem. Cria 3 contas fictícias, 2 consultas e 1 orientação por rodada. Não remove registros. API local real, usando o banco configurado no backend. Não usa credenciais de contas existentes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "testPassword",
      "value": "QA-Ficticio123!"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.environment.get('baseUrl') !== 'http://127.0.0.1:3000/api') throw new Error('Selecione o ambiente MedTrack Local antes de executar.');"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 — Cadastro de paciente",
      "item": [
        {
          "name": "Iniciar rodada e verificar API",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Banco conectado', () => pm.expect(pm.response.json()).to.eql({ok:true,db:'mongodb'}));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId=pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('runId',runId);",
                  "for (const role of ['patient','doctor','other']) pm.collectionVariables.set(role+'Email','qa-'+role+'-'+runId+'@example.test');",
                  "pm.collectionVariables.set('day',new Date(Date.now()+7*86400000).toISOString().slice(0,10));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cadastrar paciente fictício",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Paciente {{runId}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"patient\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('patientId',pm.response.json().user.id);",
                  "pm.test('Perfil correto', () => pm.expect(pm.response.json().user.role).to.eql('patient'));",
                  "pm.test('Não expõe senha nem hash', () => { const u=pm.response.json().user; pm.expect(u).not.to.have.property('password'); pm.expect(u).not.to.have.property('passwordHash'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Cadastro de médico",
      "item": [
        {
          "name": "Cadastrar médico fictício com CRM e UF",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"QA Médico {{runId}}\",\n  \"email\": \"{{doctorEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"doctor\",\n  \"specialty\": \"Especialidade fictícia QA\",\n  \"crm\": \"999999\",\n  \"crmUf\": \"CE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('doctorId',pm.response.json().user.id);",
                  "pm.test('Perfil correto', () => pm.expect(pm.response.json().user.role).to.eql('doctor'));",
                  "pm.test('Não expõe senha nem hash', () => { const u=pm.response.json().user; pm.expect(u).not.to.have.property('password'); pm.expect(u).not.to.have.property('passwordHash'); });",
                  "pm.test('Dados profissionais retornados', () => { const u=pm.response.json().user; pm.expect(u.crm).to.eql('999999'); pm.expect(u.crmUf).to.eql('CE'); });"
                ]
              }
            }
          ]
        }
      ]
    },
